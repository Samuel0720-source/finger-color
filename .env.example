# Copy to .env.local for local work with `vercel dev`. Never commit a real key.
# On Vercel: Project > Settings > Environment Variables.

# Required for the AI part of the assistant. Without it the assistant still answers
# common questions from its built-in list. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. A Gemini model that is free of charge on the Free Tier.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional limits (requests). Defaults: 6 per minute and 40 per day per visitor, 300 per day in total.
# CHAT_PER_MINUTE=6
# CHAT_PER_DAY=40
# CHAT_GLOBAL_PER_DAY=300
